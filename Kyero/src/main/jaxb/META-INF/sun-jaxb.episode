<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb">
  <jaxb:bindings scd="x-schema::" if-exists="true" auto-acknowledge="true">
    <jaxb:schemaBindings map="false">
      <jaxb:package name="org.openestate.io.kyero.xml"/>
    </jaxb:schemaBindings>
    <jaxb:bindings scd="root" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.kyero.xml.Root"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~imagesType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.kyero.xml.ImagesType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~kyeroType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.kyero.xml.KyeroType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~propertyType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.kyero.xml.PropertyType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~langType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.kyero.xml.LangType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~gpsLocationType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.kyero.xml.GpsLocationType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~surfaceType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.kyero.xml.SurfaceType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~energyRatingType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.kyero.xml.EnergyRatingType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~urlType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.kyero.xml.UrlType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~featuresType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.kyero.xml.FeaturesType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~currencyType" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.kyero.xml.CurrencyType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~priceFreqType" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.kyero.xml.PriceFreqType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~energyRatingMarkType" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.kyero.xml.EnergyRatingMarkType"/>
    </jaxb:bindings>
  </jaxb:bindings>
</jaxb:bindings>

