<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb">
  <jaxb:bindings scd="x-schema::" if-exists="true" auto-acknowledge="true">
    <jaxb:schemaBindings map="false">
      <jaxb:package name="org.openestate.io.trovit.xml"/>
    </jaxb:schemaBindings>
    <jaxb:bindings scd="~AdType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.trovit.xml.AdType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="trovit" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.trovit.xml.Trovit"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~PictureType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.trovit.xml.PictureType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~PriceType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.trovit.xml.PriceType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~FloorAreaType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.trovit.xml.FloorAreaType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~PlotAreaType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.trovit.xml.PlotAreaType"/>
    </jaxb:bindings>
  </jaxb:bindings>
</jaxb:bindings>

