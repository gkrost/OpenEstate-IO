<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb">
  <jaxb:bindings scd="x-schema::" if-exists="true" auto-acknowledge="true">
    <jaxb:schemaBindings map="false">
      <jaxb:package name="org.openestate.io.wis_it.xml"/>
    </jaxb:schemaBindings>
    <jaxb:bindings scd="WIS" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.wis_it.xml.WIS"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~ObjectType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.wis_it.xml.ObjectType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~areaType" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.wis_it.xml.AreaType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~conditionType" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.wis_it.xml.ConditionType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~energyEfficiencyClass" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.wis_it.xml.EnergyEfficiencyClass"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~energyStandard" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.wis_it.xml.EnergyStandard"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~heatingType" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.wis_it.xml.HeatingType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~marketingType" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.wis_it.xml.MarketingType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~propertyType" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.wis_it.xml.PropertyType"/>
    </jaxb:bindings>
  </jaxb:bindings>
</jaxb:bindings>

