<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<bindings version="3.0" xmlns="https://jakarta.ee/xml/ns/jaxb">
  <bindings scd="x-schema::tns" if-exists="true" auto-acknowledge="true" xmlns:tns="http://www.filemaker.com/fmpxmlresult">
    <schemaBindings map="false">
      <package name="org.openestate.io.filemaker.xml.result"/>
    </schemaBindings>
    <bindings scd="~tns:ResultSetType" if-exists="true" auto-acknowledge="true">
      <class ref="org.openestate.io.filemaker.xml.result.ResultSetType"/>
    </bindings>
    <bindings scd="~tns:MetaDataType" if-exists="true" auto-acknowledge="true">
      <class ref="org.openestate.io.filemaker.xml.result.MetaDataType"/>
    </bindings>
    <bindings scd="tns:FMPXMLRESULT" if-exists="true" auto-acknowledge="true">
      <class ref="org.openestate.io.filemaker.xml.result.FMPXMLRESULT"/>
    </bindings>
    <bindings scd="~tns:ProductType" if-exists="true" auto-acknowledge="true">
      <class ref="org.openestate.io.filemaker.xml.result.ProductType"/>
    </bindings>
    <bindings scd="~tns:DatabaseType" if-exists="true" auto-acknowledge="true">
      <class ref="org.openestate.io.filemaker.xml.result.DatabaseType"/>
    </bindings>
    <bindings scd="~tns:FieldType" if-exists="true" auto-acknowledge="true">
      <typesafeEnumClass ref="org.openestate.io.filemaker.xml.result.FieldType"/>
    </bindings>
  </bindings>
  <bindings scd="x-schema::tns" if-exists="true" auto-acknowledge="true" xmlns:tns="http://www.filemaker.com/fmpxmllayout">
    <schemaBindings map="false">
      <package name="org.openestate.io.filemaker.xml.layout"/>
    </schemaBindings>
    <bindings scd="~tns:ValueListsType" if-exists="true" auto-acknowledge="true">
      <class ref="org.openestate.io.filemaker.xml.layout.ValueListsType"/>
    </bindings>
    <bindings scd="~tns:LayoutType" if-exists="true" auto-acknowledge="true">
      <class ref="org.openestate.io.filemaker.xml.layout.LayoutType"/>
    </bindings>
    <bindings scd="tns:FMPXMLLAYOUT" if-exists="true" auto-acknowledge="true">
      <class ref="org.openestate.io.filemaker.xml.layout.FMPXMLLAYOUT"/>
    </bindings>
    <bindings scd="~tns:ProductType" if-exists="true" auto-acknowledge="true">
      <class ref="org.openestate.io.filemaker.xml.layout.ProductType"/>
    </bindings>
    <bindings scd="~tns:FieldStyleType" if-exists="true" auto-acknowledge="true">
      <typesafeEnumClass ref="org.openestate.io.filemaker.xml.layout.FieldStyleType"/>
    </bindings>
  </bindings>
</bindings>

