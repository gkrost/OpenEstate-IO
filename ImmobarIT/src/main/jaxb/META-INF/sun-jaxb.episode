<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb">
  <jaxb:bindings scd="x-schema::" if-exists="true" auto-acknowledge="true">
    <jaxb:schemaBindings map="false">
      <jaxb:package name="org.openestate.io.immobar_it.xml"/>
    </jaxb:schemaBindings>
    <jaxb:bindings scd="realestate" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.immobar_it.xml.Realestate"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~CompanyType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.immobar_it.xml.CompanyType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~PropertyType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.immobar_it.xml.PropertyType"/>
    </jaxb:bindings>
  </jaxb:bindings>
</jaxb:bindings>

