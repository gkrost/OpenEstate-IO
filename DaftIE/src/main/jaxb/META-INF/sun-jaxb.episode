<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<jaxb:bindings version="3.0" xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb">
  <jaxb:bindings scd="x-schema::" if-exists="true" auto-acknowledge="true">
    <jaxb:schemaBindings map="false">
      <jaxb:package name="org.openestate.io.daft_ie.xml"/>
    </jaxb:schemaBindings>
    <jaxb:bindings scd="~overseasRentalAdType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.daft_ie.xml.OverseasRentalAdType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~overseasSaleAdType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.daft_ie.xml.OverseasSaleAdType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="daft" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.daft_ie.xml.Daft"/>
    </jaxb:bindings>
    <jaxb:bindings scd="feedindex" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.daft_ie.xml.Feedindex"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~featuresType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.daft_ie.xml.FeaturesType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~pdfsType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.daft_ie.xml.PdfsType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~photosType" if-exists="true" auto-acknowledge="true">
      <jaxb:class ref="org.openestate.io.daft_ie.xml.PhotosType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~propertyType" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.daft_ie.xml.PropertyType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~houseType" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.daft_ie.xml.HouseType"/>
    </jaxb:bindings>
    <jaxb:bindings scd="~commercialType" if-exists="true" auto-acknowledge="true">
      <jaxb:typesafeEnumClass ref="org.openestate.io.daft_ie.xml.CommercialType"/>
    </jaxb:bindings>
  </jaxb:bindings>
</jaxb:bindings>

